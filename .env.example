# Copy to .env, chmod 600, never commit.
#
# Every variable below is read at startup and never again: changing one means recreating
# the containers. Anything left empty falls back to the default shown in the comment, and
# an empty PROXMOX_URL or CUP_ENABLED=false disables that source entirely rather than
# failing — the collector runs with whatever it was given.

# --- Baserow (required) -------------------------------------------------------
# A *database token* (Authorization: Token <t>), NOT the admin JWT. The JWT can alter the
# structure of your tables and has no business in a process that runs every 15 minutes.
# The collector's token needs create/read/update AND delete: rows no longer seen are
# really deleted after the grace period (see README.md, Reconciliation rules).
#
# BASEROW_VERIFY_TLS=false is for an internal certificate. The cleaner alternative, if you
# run your own CA, is to point REQUESTS_CA_BUNDLE at it and leave verification on.
BASEROW_URL=https://baserow.internal.lcl
BASEROW_TOKEN=
BASEROW_VERIFY_TLS=false

# Table ids, read from the URL when you open each table in Baserow. A renamed field comes
# back empty from the API with no error, so these must match the tables described in
# README.md, Data model.
TABLE_NODE=
TABLE_CONTAINER=
TABLE_IMAGES=
# Read by the web console only. The collector never writes to Application — it is a
# business grouping, 100% manual. The console needs it to connect an image CVE to the
# service it actually affects.
TABLE_APPLICATION=

# --- Proxmox (leave PROXMOX_URL empty to disable this source) ------------------
# Format: user@realm!tokenid=SECRET. The token MUST be created with --privsep 0, otherwise
# it carries no permission at all and every call comes back empty — see README.md.
PROXMOX_URL=https://your-hypervisor.internal.lcl:8006
PROXMOX_TOKEN=
PROXMOX_VERIFY_TLS=false

# IPAM uses two tables: VLAN is a read-only reference you maintain by hand, IPAM is
# written by the collector. Both become required as soon as PROXMOX_URL is set.
TABLE_VLAN=
TABLE_IPAM=

# --- Docker -------------------------------------------------------------------
# A Docker host is scanned if it appears here OR if its Node row carries the "docker" tag
# in `Roles` (set by hand in Baserow). For hosts discovered through the tag, the socket
# proxy URL is rebuilt by convention:
#
#     http://{Node.name}{DNS_SUFFIX}:{DOCKER_SOCKET_PROXY_PORT}
#
# DOCKER_HOSTS stays useful for a host that has no Node row (not on Proxmox), or to
# override the URL built by convention. Format: "name=url,name=url". The name must match
# Node.name EXACTLY, or Container.Host silently stays empty — the comparison is
# case-insensitive, since DNS does not distinguish 'myTools' from 'mytools'.
DOCKER_HOSTS=
DOCKER_SOCKET_PROXY_PORT=2375

# DNS suffix, used in two places: building the URL of Docker hosts discovered by tag, and
# as a fallback to find the IP of a VM with no Guest Agent (the Proxmox name is usually
# the DNS name). Leave empty if Node.name already resolves as it is.
DNS_SUFFIX=.internal.lcl

# --- Cup (image updates) — off by default -------------------------------------
# Runs as a subprocess (the binary ships in the image, see Dockerfile): no server, no URL
# to configure. It does reach out to public registries, which is why it is not on by
# default. One call covers every image at once.
CUP_ENABLED=false

# --- Trivy (CVE) — off by default ---------------------------------------------
# Same principle as Cup, one subprocess per image. TRIVY_CACHE_DIR must be a persistent
# volume (see compose.yaml): the vulnerability database is about 1 GB and is downloaded
# again in full on every restart otherwise.
TRIVY_ENABLED=false
TRIVY_CACHE_DIR=/cache

# --- Web console (the `web` service in compose.yaml) --------------------------
# A dedicated token, strongly recommended. Exactly what the console needs:
#
#   read    on all six tables
#   update  on those whose manual fields it lets you correct
#   create  on Ipam, Application and Node, and on those three only — reserving an
#           address, declaring an application, and adding a piece of equipment Proxmox
#           cannot see are the only additions the console offers
#   delete  on NO table. It deletes nothing, and that is what bounds the damage if the
#           browser-facing process is ever compromised: the inventory can be falsified,
#           not erased.
#
# A Baserow database token can be restricted neither by origin nor by row: these four
# checkboxes per table are the only granularity available.
# If empty, the console falls back to BASEROW_TOKEN — fine to get started, not after.
WEB_BASEROW_TOKEN=

# How long the in-memory snapshot lives. The six tables reload in about a second, and the
# collector writes every 15 minutes at best: there is nothing to gain below this, and
# little to gain far above it.
WEB_CACHE_TTL=60

# Application icon discovery. The console reads the HTML of the URLs entered in the
# Application table to find its <link rel="icon">, because `<origin>/favicon.ico` alone
# finds only a minority of icons. This is the single exception to "this service talks to
# Baserow and nothing else" — only the HTML is fetched, never the image itself, which the
# browser loads directly. false = applications show their initial instead.
WEB_FAVICON_DISCOVERY=true

# --- Scheduling ----------------------------------------------------------------
# Seconds between passes. Containers are the fast, frequent pass; nodes change rarely;
# Cup queries registries; Trivy scans every image one by one and is by far the longest.
# The State screen lets you trigger either family on demand without waiting for these.
INTERVAL_CONTAINERS=900
INTERVAL_NODES=3600
INTERVAL_CUP=21600
INTERVAL_TRIVY=86400

# The only safety net against a one-off glitch (a failed pass, a host down for a few
# minutes): past this delay, an absence is treated as a real disappearance and the row is
# deleted for good. 72h rather than 48h, so that a host down over a long weekend survives
# without anyone being paged.
RETIRE_GRACE_HOURS=72

# true = one single pass, then exit (tests).
RUN_ONCE=false
LOG_LEVEL=INFO

# --- Weekly update of non-critical stacks --------------------------------------
# Used by `python -m outils.maj` only (see README.md). Neither the collector nor the
# console reads these: without them, everything else behaves exactly the same.
#
# Portainer access token: Portainer -> My account -> Access tokens. The script only
# redeploys stacks — it creates nothing and deletes nothing — but Portainer cannot
# restrict a token to those actions, so it carries the full rights of the account that
# issued it. Create it on a dedicated account rather than on your administrator.
PORTAINER_URL=
PORTAINER_TOKEN=
PORTAINER_VERIFY_TLS=false

# Which Application criticality levels are eligible for automatic update. Anything not
# listed, and anything whose criticality is not filled in, is left alone.
UPDATE_CRITICALITIES=Low

# Escape hatch: stacks never to touch, whatever their criticality. Best left empty. A
# stack that should not update itself is a stack whose criticality says so — there, the
# decision stays visible in the console; here it would be invisible and forgotten.
UPDATE_EXCLUDE=
