# Copier en .env, chmod 600, ne jamais committer.

# --- Baserow (obligatoire) --------------------------------------------------
# Database token (Authorization: Token <t>), PAS le JWT admin — celui-ci permet de
# modifier la structure des tables, aucune raison qu'il traîne dans ce process.
# Droits create/read/update/delete (la suppression réelle de ce qui n'est plus vu
# est activée, voir README.md).
BASEROW_URL=https://baserow.internal.lcl
BASEROW_TOKEN=
BASEROW_VERIFY_TLS=false

TABLE_NODE=
TABLE_CONTAINER=
TABLE_IMAGES=
# Lue par la console web uniquement : le collecteur n'écrit jamais dans Application
# (regroupement métier, 100% manuel). La console, elle, en a besoin pour relier une CVE
# d'image au service qu'elle concerne réellement.
TABLE_APPLICATION=

# --- Proxmox (laisser PROXMOX_URL vide pour désactiver la source) ----------
PROXMOX_URL=https://votre-hyperviseur.internal.lcl:8006
# Format : user@realm!tokenid=SECRET — le token DOIT être créé avec --privsep 0,
# voir README.md.
PROXMOX_TOKEN=
PROXMOX_VERIFY_TLS=false

# IPAM : 2 tables (VLAN en lecture seule, IPAM en écriture). Obligatoires dès que
# PROXMOX_URL est renseigné.
TABLE_VLAN=
TABLE_IPAM=

# --- Docker ------------------------------------------------------------------
# Un hôte Docker est scanné s'il apparaît ici OU si son Node correspondant porte le
# tag "docker" dans `roles` (posé à la main dans Baserow, sur la fiche du Node). Pour
# les hôtes découverts via le tag, l'URL du socket-proxy est reconstruite par
# convention : http://{Node.name}{DNS_SUFFIX}:{DOCKER_SOCKET_PROXY_PORT}.
#
# DOCKER_HOSTS reste utile pour un hôte hors Proxmox (pas de Node), ou pour surcharger
# l'URL construite par convention. Format : "nom=url,nom=url" — le nom doit correspondre
# EXACTEMENT à Node.name, sinon Container.host reste vide sans erreur (comparaison
# insensible à la casse : DNS ne différencie pas 'myTools' de 'mytools').
DOCKER_HOSTS=
DOCKER_SOCKET_PROXY_PORT=2375

# Suffixe DNS utilisé à deux endroits : construire l'URL des hôtes Docker découverts par
# tag, et en repli pour trouver l'IP d'une VM sans Guest Agent (le nom Proxmox est
# généralement identique au nom DNS). Laisser vide si Node.name est déjà résolvable tel quel.
DNS_SUFFIX=.internal.lcl

# --- Cup (mises à jour d'image) — désactivé par défaut ------------------------
# Tourne en sous-processus (binaire dans l'image, voir Dockerfile) : pas d'URL à
# configurer. Appels réseau vers des registres publics, pas anodin par défaut.
CUP_ENABLED=false

# --- Trivy (CVE) — désactivé par défaut ---------------------------------------
# Même principe que Cup : sous-processus, pas de serveur. /cache DOIT être un volume
# persistant (voir compose.yaml) : la base de vulnérabilités fait ~1 Go, retéléchargée
# en entier à chaque redémarrage sinon.
TRIVY_ENABLED=false
TRIVY_CACHE_DIR=/cache

# --- Console web (service `web` de compose.yaml) ------------------------------
# Token dédié, fortement recommandé. Droits exacts dont la console a besoin :
#   read    sur les six tables
#   update  sur celles dont elle permet de corriger les champs manuels
#   create  sur Ipam et Application, et sur elles seules (réserver une adresse,
#           déclarer une application — les deux seuls ajouts que la console propose)
#   delete  sur AUCUNE table : elle ne supprime rien, et c'est ce qui borne les dégâts si
#           le process exposé au navigateur est compromis — fausser l'inventaire, pas
#           l'effacer.
# Un token de base Baserow ne se restreint ni par origine ni par ligne : ces quatre cases
# par table sont la seule granularité disponible.
# Si vide, la console reprend BASEROW_TOKEN (pratique en test, à éviter ensuite).
WEB_BASEROW_TOKEN=

# Durée de vie de l'instantané en mémoire. Les six tables se rechargent en ~1 s ; le
# collecteur, lui, n'écrit au mieux que toutes les 15 min.
WEB_CACHE_TTL=60

# Découverte des icônes d'application. La console lit le HTML des URL saisies dans la table
# Application pour y trouver la balise <link rel="icon"> : `<origine>/favicon.ico` seul ne
# trouve qu'une minorité des icônes. Seule entorse au principe « ce service ne parle qu'à
# Baserow » — seul le HTML est lu, jamais l'image, qui reste chargée par le navigateur.
# false = les applications s'affichent avec leur initiale.
WEB_FAVICON_DISCOVERY=true

# --- Ordonnancement -----------------------------------------------------------
INTERVAL_CONTAINERS=900
INTERVAL_NODES=3600
INTERVAL_CUP=21600
INTERVAL_TRIVY=86400
# Le seul filet contre un aléa ponctuel (pass qui rate, hôte HS quelques minutes) : passé
# ce délai, l'absence est traitée comme une vraie disparition (suppression réelle, voir
# README.md). Choisi à 72h plutôt que 48h pour absorber une panne prolongée d'un hôte
# sans notification immédiate.
RETIRE_GRACE_HOURS=72

# true = une seule passe puis sortie (tests)
RUN_ONCE=false
LOG_LEVEL=INFO

# --- Mise à jour hebdomadaire des stacks non critiques ------------------------
# Utilisées par `python -m outils.maj` uniquement (voir README). Ni le collecteur ni la
# console ne les lisent : sans elles, tout le reste fonctionne à l'identique.
#
# Clé d'accès Portainer : Portainer -> Mon compte -> Access tokens. Le script redéploie des
# stacks, il ne crée ni ne supprime rien — mais Portainer ne sait pas restreindre une clé à
# ces seules actions, elle vaut donc les droits du compte qui l'émet. À créer sur un compte
# dédié plutôt que sur l'administrateur.
PORTAINER_URL=
PORTAINER_TOKEN=
PORTAINER_VERIFY_TLS=false

# Criticités (table Application) éligibles à la mise à jour automatique. Tout ce qui n'est
# pas listé, et tout ce dont la criticité n'est pas renseignée, est laissé tranquille.
MAJ_CRITICITES=Low

# Échappatoire : stacks à ne jamais toucher, quelle que soit leur criticité. À laisser
# vide. Une stack qui ne doit pas se mettre à jour toute seule se règle par sa criticité
# dans la CMDB, où la décision reste visible — ici, elle serait invisible et oubliée.
MAJ_EXCLUS=
